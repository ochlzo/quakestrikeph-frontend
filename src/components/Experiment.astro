---
/**
 * Experiment.astro
 *
 * An overlay component that plots experimental earthquake visualizations
 * on top of Map.astro. Must be rendered on the same page as <Map />.
 *
 * Listens for the "leaflet:ready" custom event dispatched by Map.astro,
 * then adds layers (markers, circles) onto the shared Leaflet map instance.
 */
---

<script>
  import L from "leaflet";

  // Demo epicenter: Mayon Volcano, Albay — central-ish and visually recognizable.
  const EPICENTER: [number, number] = [13.2543, 123.6857];
  const RADIUS_KM = 50;

  document.addEventListener("leaflet:ready", (e) => {
    const { map } = (e as CustomEvent<{ map: L.Map }>).detail;

    // --- Epicenter marker ---
    const epicenterIcon = L.divIcon({
      className: "",
      html: `
        <div style="
          width: 14px; height: 14px;
          background: #ff3b30;
          border: 2.5px solid #fff;
          border-radius: 50%;
          box-shadow: 0 0 0 3px rgba(255,59,48,0.4);
        "></div>
      `,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });

    L.marker(EPICENTER, { icon: epicenterIcon })
      .addTo(map)
      .bindPopup(`
        <strong>📍 Epicenter (Demo)</strong><br/>
        Mayon Volcano, Albay<br/>
        <small>${EPICENTER[0]}°N, ${EPICENTER[1]}°E</small><br/>
        Radius: <strong>${RADIUS_KM} km</strong>
      `)
      .openPopup();

    // --- 50km radius circle ---
    L.circle(EPICENTER, {
      radius: RADIUS_KM * 1000, // Leaflet uses meters
      color: "#ff3b30",
      weight: 2,
      fillColor: "#ff3b30",
      fillOpacity: 0.12,
      dashArray: "6 4",
    }).addTo(map);
  });
</script>
