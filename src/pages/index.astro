---
import Layout from '../layouts/Layout.astro';
import Map from '../components/Map.astro';
import ZoomSlider from '../components/ZoomSlider.astro';
import MapInspector from '../components/MapInspector.astro';
import Experiment from '../components/Experiment.astro';
---

<Layout>
  <div style="position: relative; height: 100vh; width: 100%;">
    <Map height="100vh" />
    <ZoomSlider />
    <MapInspector enabled={false} />
  </div>
  <Experiment />
</Layout>