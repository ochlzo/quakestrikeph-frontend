---
import Layout from "../layouts/Layout.astro";
import { AdminGate } from "../components/admin-gate";
import { AdminLogoutButton } from "../components/admin-logout-button";
import { AdminUsersPanel } from "../components/admin-users-panel";
---

<Layout>
  <AdminGate client:load>
    <main class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.18),_transparent_28%),radial-gradient(circle_at_bottom_right,_rgba(248,113,113,0.16),_transparent_28%),linear-gradient(180deg,_var(--background),_color-mix(in_oklch,var(--background),var(--foreground)_2%))] text-foreground">
      <section class="mx-auto min-h-screen max-w-6xl px-6 py-10 sm:px-10">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="space-y-2">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground">
              QuakeStrike PH
            </p>
            <h1 class="text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">
              Admin Dashboard
            </h1>
            <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
              The user list below comes from <span class="font-medium text-foreground">PubUser</span>, which is synced from Supabase Auth logins and kept current as accounts sign in.
            </p>
          </div>
        </div>

        <div class="mb-6 flex justify-end">
          <AdminLogoutButton client:load />
        </div>

        <AdminUsersPanel client:load />
      </section>
    </main>
  </AdminGate>
</Layout>
